.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checking and linting
.mypy_cache/
.pyright/
.ruff_cache/

# Jupyter notebooks
.ipynb_checkpoints/
*.ipynb_checkpoints

# ==========================================
# IDE AND EDITORS
# ==========================================

.vscode/
.idea/
*.swp
*.swo
*~

